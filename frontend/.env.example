# Attendly frontend environment variables
# Copy to .env.local and fill in your external APK download URLs
# (e.g. GitHub Releases URLs) so the site stays small for Netlify.

VITE_APK_URL_64=https://github.com/your-org/attendly/releases/download/v1.0.0/attendance-1.0.0-arm64-v8a.apk
VITE_APK_URL_32=https://github.com/your-org/attendly/releases/download/v1.0.0/attendance-1.0.0-armeabi-v7a.apk
